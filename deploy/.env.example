# Global Environment Settings
GEODISPATCH_ENV=development

# CAMARA integration
# Leave NOKIA_NAC_API_KEY empty to use the local fallback at mock_camara:8081.
# When the hackathon provides sandbox credentials, set the endpoint, key, host,
# and (if required) token below; the supervisor will use that official service.
MOCK_CAMARA_PORT=8081
MOCK_NOKIA_NAC_BASE_URL=http://mock_camara:8081
NOKIA_NAC_BASE_URL=https://network-as-code.nokia.rapidapi.com
NOKIA_NAC_API_KEY=
NOKIA_NAC_HOST=network-as-code.nokia.rapidapi.com
NOKIA_NAC_TOKEN=

# Go Supervisor Configuration
# Values below are consumed by the root Compose integration override.
# `app` is Yassine's real agent service; its decision endpoint is /decide.
INTEGRATION_AGENT_URL=http://app:8000/decide
INTEGRATION_DATABASE_URL=postgres://geodispatch:geodispatch@postgres:5432/geodispatch?sslmode=disable

# `supervisor/.env` is still created for Ilias's standalone Compose workflow.
# The root Compose file overrides its service-connection values when this
# integrated stack is run.
